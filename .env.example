# 이 파일은 환경 변수 템플릿입니다. 실제 값을 이 파일에 넣지 마세요.
# 로컬 개발: 이 파일을 .env (또는 .env.local)로 복사한 뒤 값을 채우세요. .env 파일은 git에 올라가지 않습니다.
# 배포(Firebase App Hosting): 공개 웹 설정값은 apphosting.yaml의 env에 있고,
# GEMINI_API_KEY와 TEACHER_PIN은 App Hosting 비밀값(Secret Manager)으로 설정합니다.

# Firebase 웹 앱 설정 (공개되는 값)
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# 서버 전용 비밀값 (절대 git에 올리지 마세요)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
TEACHER_PIN=YOUR_TEACHER_PIN
